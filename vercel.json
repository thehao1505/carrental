{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "dvdldaiduong.com" }],
      "destination": "https://www.dvdldaiduong.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
